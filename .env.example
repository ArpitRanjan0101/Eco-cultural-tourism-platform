# Copy to .env and replace every value. Never commit .env.
# Generate secrets with: docker run --rm alpine sh -c "head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n'"
# Use URL-safe values (hex) for passwords: they are embedded in DATABASE_URL / REDIS_URL.

# --- Server ---
NODE_ENV=development
PORT=4000
PUBLIC_BASE_URL=http://localhost:8080
# Comma-separated browser origins allowed by CORS (the future Next.js app). Empty = none.
CORS_ORIGIN=http://localhost:3000
# Number of trusted reverse-proxy hops in front of the API (nginx = 1).
TRUST_PROXY=1
LOG_LEVEL=info

# --- Database (DATABASE_URL is derived inside docker-compose.yml) ---
POSTGRES_USER=tourism
POSTGRES_PASSWORD=replace-with-hex-secret
POSTGRES_DB=tourism
DATABASE_POOL_MAX=10

# --- Redis (REDIS_URL is derived inside docker-compose.yml) ---
REDIS_PASSWORD=replace-with-hex-secret

# --- Internal BFF service token (server-side only, never NEXT_PUBLIC_, min 32 chars) ---
INTERNAL_SERVICE_TOKEN=replace-with-64-char-hex-secret
# Optional: previous token accepted during rotation. Leave empty otherwise.
INTERNAL_SERVICE_TOKEN_PREVIOUS=

# --- User authentication (JWT access tokens + rotating opaque refresh tokens) ---
# HS256 signing secret, min 32 chars, must differ from INTERNAL_SERVICE_TOKEN.
JWT_ACCESS_SECRET=replace-with-64-char-hex-secret
JWT_ISSUER=jharkhand-tourism-api
JWT_AUDIENCE=jharkhand-tourism-bff
JWT_ACCESS_TTL_SECONDS=900
# Absolute session lifetime from login; refresh rotation does not extend it.
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30

# --- Optional first super administrator, created by `npm run db:seed` (password min 12 chars) ---
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Nginx host ports ---
# Public edge listener (webhooks, /health/live).
NGINX_PUBLIC_PORT=8080
# Private listener for the BFF; published on 127.0.0.1 only in development.
NGINX_INTERNAL_PORT=8081
