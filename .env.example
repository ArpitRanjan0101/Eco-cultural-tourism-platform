# Copy to .env and replace every value. Never commit .env.
# Generate secrets with: docker run --rm alpine sh -c "head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n'"
# Use URL-safe values (hex) for passwords: they are embedded in DATABASE_URL / REDIS_URL.

# --- Server ---
NODE_ENV=development
PORT=4000
PUBLIC_BASE_URL=http://localhost:8080
# Comma-separated browser origins allowed by CORS (the future Next.js app). Empty = none.
CORS_ORIGIN=http://localhost:3000
# Number of trusted reverse-proxy hops in front of the API (nginx = 1).
TRUST_PROXY=1
LOG_LEVEL=info

# --- Database (DATABASE_URL is derived inside docker-compose.yml) ---
POSTGRES_USER=tourism
POSTGRES_PASSWORD=replace-with-hex-secret
POSTGRES_DB=tourism
DATABASE_POOL_MAX=10

# --- Redis (REDIS_URL is derived inside docker-compose.yml) ---
REDIS_PASSWORD=replace-with-hex-secret

# --- Internal BFF service token (server-side only, never NEXT_PUBLIC_, min 32 chars) ---
INTERNAL_SERVICE_TOKEN=replace-with-64-char-hex-secret
# Optional: previous token accepted during rotation. Leave empty otherwise.
INTERNAL_SERVICE_TOKEN_PREVIOUS=

# --- User authentication (JWT access tokens + rotating opaque refresh tokens) ---
# HS256 signing secret, min 32 chars, must differ from INTERNAL_SERVICE_TOKEN.
JWT_ACCESS_SECRET=replace-with-64-char-hex-secret
JWT_ISSUER=jharkhand-tourism-api
JWT_AUDIENCE=jharkhand-tourism-bff
JWT_ACCESS_TTL_SECONDS=900
# Absolute session lifetime from login; refresh rotation does not extend it.
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30

# --- S3-compatible media storage (dev: SeaweedFS container "storage") ---
# Internal endpoint used by the API; public endpoint is what browsers use for presigned URLs.
STORAGE_ENDPOINT=http://storage:8333
STORAGE_PUBLIC_ENDPOINT=http://localhost:8333
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=replace-with-hex-key
STORAGE_SECRET_KEY=replace-with-hex-secret
STORAGE_PUBLIC_BUCKET=tourism-public
STORAGE_PRIVATE_BUCKET=tourism-private
# Base URL for public images (CDN in production).
STORAGE_PUBLIC_BASE_URL=http://localhost:8333/tourism-public
STORAGE_FORCE_PATH_STYLE=true
STORAGE_HOST_PORT=8333

# --- Payments (Razorpay). Use test-mode keys (rzp_test_...) outside production. ---
# Empty keys disable payment routes in development (503 PAYMENTS_NOT_CONFIGURED).
PAYMENT_PROVIDER=razorpay
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
# Dashboard > Webhooks secret; the public webhook URL is <PUBLIC_BASE_URL>/api/v1/webhooks/payments/razorpay
PAYMENT_WEBHOOK_SECRET=
PAYMENT_API_BASE_URL=https://api.razorpay.com/v1

# --- Email (dev: Mailpit, UI at http://localhost:8025) and web-app links in messages ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Jharkhand Tourism <no-reply@jharkhand-tourism.local>
APP_WEB_URL=http://localhost:3000
MAILPIT_UI_PORT=8025

# --- Optional first super administrator, created by `npm run db:seed` (password min 12 chars) ---
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Nginx host ports ---
# Public edge listener (webhooks, /health/live).
NGINX_PUBLIC_PORT=8080
# Private listener for the BFF; published on 127.0.0.1 only in development.
NGINX_INTERNAL_PORT=8081
