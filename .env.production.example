# Production template for docker-compose.prod.yml. Copy to .env.production on the server
# (chmod 600, owned by the deploy user) and replace EVERY value. Never commit .env.production.
# Generate secrets: docker run --rm alpine sh -c "head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n'"
# Use hex for passwords: they are embedded in connection URLs. The API refuses to start in
# production with placeholder secrets, missing payment keys or a non-https PUBLIC_BASE_URL.

# --- Release ---
IMAGE_REPOSITORY=jharkhand-tourism-backend
# Immutable tag, e.g. the git commit being deployed.
IMAGE_TAG=replace-with-git-commit

# --- Public URLs ---
PUBLIC_BASE_URL=https://api.example.org
APP_WEB_URL=https://www.example.org
CORS_ORIGIN=https://www.example.org
TRUST_PROXY=1
LOG_LEVEL=info

# --- PostgreSQL: schema owner (migrations only) and least-privilege runtime role (API/worker) ---
POSTGRES_USER=tourism_owner
POSTGRES_PASSWORD=replace-with-hex-secret
POSTGRES_DB=tourism
DATABASE_APP_USER=tourism_app
DATABASE_APP_PASSWORD=replace-with-hex-secret
DATABASE_POOL_MAX=10

# --- Redis ---
REDIS_PASSWORD=replace-with-hex-secret

# --- BFF service token and JWT (min 32 chars each, different values) ---
INTERNAL_SERVICE_TOKEN=replace-with-64-char-hex-secret
INTERNAL_SERVICE_TOKEN_PREVIOUS=
JWT_ACCESS_SECRET=replace-with-64-char-hex-secret
JWT_ISSUER=jharkhand-tourism-api
JWT_AUDIENCE=jharkhand-tourism-bff

# --- S3-compatible object storage (AWS S3, Cloudflare R2, Wasabi... — DECISIONS O7) ---
STORAGE_ENDPOINT=https://s3.ap-south-1.amazonaws.com
STORAGE_PUBLIC_ENDPOINT=https://s3.ap-south-1.amazonaws.com
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY=replace-with-access-key
STORAGE_SECRET_KEY=replace-with-secret-key
STORAGE_PUBLIC_BUCKET=replace-with-public-bucket
STORAGE_PRIVATE_BUCKET=replace-with-private-bucket
# CDN or bucket URL serving public images.
STORAGE_PUBLIC_BASE_URL=https://cdn.example.org
STORAGE_FORCE_PATH_STYLE=false

# --- Razorpay live keys (production refuses to start without them) ---
PAYMENT_PROVIDER=razorpay
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# --- SMTP provider (DECISIONS O6) ---
SMTP_HOST=smtp.example.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Jharkhand Tourism <no-reply@example.org>

# --- First super administrator (used once by `run --rm migrate node src/database/cli.js seed`; then clear) ---
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# --- Edge, TLS and operations ---
HTTP_PORT=80
HTTPS_PORT=443
TLS_CERT_DIR=./infrastructure/nginx/certs
ACME_WEBROOT=./infrastructure/nginx/acme
BFF_NETWORK=jharkhand-tourism-bff
BACKUP_HOST_DIR=./backups
BACKUP_RETENTION_DAYS=14
