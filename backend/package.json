{
  "name": "jharkhand-tourism-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Jharkhand Eco & Cultural Tourism - Express modular monolith API and worker",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "worker": "node src/jobs/worker.js",
    "db:migrate": "node src/database/cli.js migrate",
    "db:rollback": "node src/database/cli.js rollback",
    "db:status": "node src/database/cli.js status",
    "db:seed": "node src/database/cli.js seed",
    "storage:init": "node src/database/storage-init.js",
    "openapi:generate": "node src/docs/generate.js",
    "lint": "eslint .",
    "test": "NODE_ENV=test DATABASE_URL=$TEST_DATABASE_URL REDIS_URL=$TEST_REDIS_URL STORAGE_PUBLIC_BASE_URL=$STORAGE_ENDPOINT/$STORAGE_PUBLIC_BUCKET-test STORAGE_PUBLIC_BUCKET=$STORAGE_PUBLIC_BUCKET-test STORAGE_PRIVATE_BUCKET=$STORAGE_PRIVATE_BUCKET-test STORAGE_PUBLIC_ENDPOINT=$STORAGE_ENDPOINT node --test --test-concurrency=1 \"tests/**/*.test.js\""
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "7.3.0",
    "@aws-sdk/client-s3": "3.723.0",
    "@aws-sdk/s3-request-presigner": "3.723.0",
    "cors": "2.8.5",
    "express": "5.1.0",
    "helmet": "8.1.0",
    "ioredis": "5.4.2",
    "jsonwebtoken": "9.0.2",
    "pg": "8.13.1",
    "pino": "9.6.0",
    "pino-http": "10.4.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "eslint": "9.17.0",
    "globals": "15.14.0",
    "supertest": "7.0.0"
  }
}
