# Frontend (Next.js) server configuration. Copy to frontend/.env and fill in.
# Every key here is server-only: none may be prefixed NEXT_PUBLIC_ (DECISIONS W19).

# Backend private listener (nginx :8081) on the shared Docker network.
BACKEND_INTERNAL_URL=http://nginx:8081

# Must equal INTERNAL_SERVICE_TOKEN in the repository root .env (at least 32 characters).
INTERNAL_SERVICE_TOKEN=replace-with-the-INTERNAL_SERVICE_TOKEN-from-the-root-env

# Public origin of this site; must equal the backend's APP_WEB_URL.
APP_ORIGIN=http://localhost:3000

# Timeout for each call to the backend, in milliseconds.
BACKEND_TIMEOUT_MS=10000

# true in production (Secure + __Host- session cookies, DECISIONS W6).
SESSION_COOKIE_SECURE=false

# Host port for the development server (127.0.0.1 only).
WEB_HOST_PORT=3000
